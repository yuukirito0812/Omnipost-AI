# Configure Supabase for real authentication and private user data. No local demo accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for authenticated draft/AI flows; required for platform publishing and OAuth.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# The cron scheduler must pass Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Preferred AI path: users connect their own Gemini Free Tier keys through Settings (encrypted in Supabase).
# Optional server-wide Gemini fallback, if you operate a trusted single-user deployment:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Vercel AI Gateway requires payment verification. Disabled unless explicitly enabled.
AI_GATEWAY_ENABLED=false
# Create developer apps; configure each callback URL as APP_URL/api/oauth/callback/<provider>
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
