# Required for live authenticated app; without these, the UI runs in local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
# The cron scheduler must pass Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Gemini key stays server-side. See /api/ai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Create developer apps; configure each callback URL as APP_URL/api/oauth/callback/<provider>
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
